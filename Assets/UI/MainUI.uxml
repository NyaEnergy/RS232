<ui:UXML xmlns:ui="UnityEngine.UIElements">

    <!-- Две панели: гибкая левая и фиксированная правая -->

    <ui:VisualElement
        name="main-panel"
        class="rs232-main-panel"
        style="
            flex-grow: 1;
            flex-direction: row;
            margin: 0px;
            padding: 0px;">

        <!-- Левая панель: заголовок и три последних показания -->

        <ui:VisualElement
            name="left-panel"
            style="
                flex-grow: 1;
                flex-shrink: 1;
                flex-basis: 0px;
                min-width: 230px;
                padding: 12px;
                flex-direction: column;">

            <ui:VisualElement
                name="header-block"
                style="
                    width: 100%;
                    margin-bottom: 12px;">

                <ui:Label
                    text="RS232"
                    class="rs232-title" />

            </ui:VisualElement>

            <ui:VisualElement
                name="history-panel"
                style="width: 100%;">

                <ui:Label
                    text="Последние показания"
                    class="rs232-history-title"
                    style="margin-bottom: 12px;" />

                <ui:Label
                    name="reading-1"
                    text="—"
                    class="rs232-reading"
                    style="margin-bottom: 8px;" />

                <ui:Label
                    name="reading-2"
                    text="—"
                    class="rs232-reading"
                    style="margin-bottom: 8px;" />

                <ui:Label
                    name="reading-3"
                    text="—"
                    class="rs232-reading" />

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Правая панель: три ряда настроек и кнопка -->

        <ui:VisualElement
            name="port-settings"
            class="rs232-settings-panel"
            style="
                width: 252px;
                min-width: 252px;
                flex-shrink: 0;
                padding: 12px;
                flex-direction: column;
                justify-content: flex-start;">

            <!-- COM-порт -->

            <ui:VisualElement
                name="port-picker"
                style="
                    width: 100%;
                    margin-bottom: 12px;">

                <ui:Label
                    text="COM-порт"
                    class="rs232-field-label"
                    style="margin-bottom: 6px;" />

                <ui:DropdownField
                    name="port-dropdown"
                    class="dark-dropdown"
                    style="
                        width: 100%;
                        height: 36px;
                        margin: 0px;" />

            </ui:VisualElement>

            <!-- Baud Rate + Data Bits -->

            <ui:VisualElement
                name="data-settings"
                style="
                    width: 100%;
                    flex-direction: row;
                    margin-bottom: 12px;">

                <ui:VisualElement
                    style="
                        flex-grow: 3;
                        flex-basis: 0px;
                        min-width: 0px;
                        margin-right: 8px;">

                    <ui:Label
                        text="Baud Rate"
                        class="rs232-field-label-small"
                        style="margin-bottom: 6px;" />

                    <ui:DropdownField
                        name="baudrate-input"
                        class="dark-dropdown"
                        style="
                            width: 100%;
                            height: 36px;
                            margin: 0px;" />

                </ui:VisualElement>

                <ui:VisualElement
                    style="
                        flex-grow: 2;
                        flex-basis: 0px;
                        min-width: 0px;">

                    <ui:Label
                        text="Data Bits"
                        class="rs232-field-label-small"
                        style="margin-bottom: 6px;" />

                    <ui:DropdownField
                        name="databits-input"
                        class="dark-dropdown"
                        style="
                            width: 100%;
                            height: 36px;
                            margin: 0px;" />

                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Parity + Flow Control -->

            <ui:VisualElement
                name="format-settings"
                style="
                    width: 100%;
                    flex-direction: row;">

                <ui:VisualElement
                    style="
                        flex-grow: 2;
                        flex-basis: 0px;
                        min-width: 0px;
                        margin-right: 8px;">

                    <ui:Label
                        text="Parity"
                        class="rs232-field-label-small"
                        style="margin-bottom: 6px;" />

                    <ui:DropdownField
                        name="parity-input"
                        class="dark-dropdown"
                        style="
                            width: 100%;
                            height: 36px;
                            margin: 0px;" />

                </ui:VisualElement>

                <ui:VisualElement
                    style="
                        flex-grow: 3;
                        flex-basis: 0px;
                        min-width: 0px;">

                    <ui:Label
                        text="Flow Control"
                        class="rs232-field-label-small"
                        style="margin-bottom: 6px;" />

                    <ui:DropdownField
                        name="flowcontrol-input"
                        class="dark-dropdown"
                        style="
                            width: 100%;
                            height: 36px;
                            margin: 0px;" />

                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Кнопка подключения -->

            <ui:Button
                name="connection-button"
                text="Подключить"
                class="rs232-connect-button"
                style="
                    width: 100%;
                    height: 40px;
                    margin: 0px;
                    margin-top: 18px;" />

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
