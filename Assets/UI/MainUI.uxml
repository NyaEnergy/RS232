
<ui:UXML xmlns:ui="UnityEngine.UIElements">

    <!-- Основная панель -->

    <ui:VisualElement
        name="main-panel"
        class="rs232-main-panel"
        style="
            flex-grow: 1;
            margin: 0px;
            padding: 12px;">

        <!-- Заголовок и статус -->

        <ui:VisualElement
            name="header-block"
            style="
                width: 260px;
                margin-bottom: 18px;">

            <ui:Label
                text="RS232"
                class="rs232-title"
                style="margin-bottom: 8px;" />

            <ui:Label
                name="connection-status"
                text="Ожидание подключения"
                class="rs232-status" />

        </ui:VisualElement>

        <!-- История последних показаний -->

        <ui:VisualElement
            name="history-panel"
            style="
                width: 260px;
                flex-grow: 1;">

            <ui:Label
                text="Последние показания"
                class="rs232-history-title"
                style="margin-bottom: 10px;" />

            <ui:Label
                name="reading-1"
                text="—"
                class="rs232-reading"
                style="margin-bottom: 8px;" />

            <ui:Label
                name="reading-2"
                text="—"
                class="rs232-reading"
                style="margin-bottom: 8px;" />

            <ui:Label
                name="reading-3"
                text="—"
                class="rs232-reading" />

        </ui:VisualElement>

        <!-- Управление подключением -->

        <ui:VisualElement
            name="connection-controls"
            style="
                width: 254px;
                margin-top: 16px;">

            <ui:Label
                text="Управление подключением"
                class="rs232-field-label"
                style="margin-bottom: 10px;" />

            <ui:Button
                name="connection-button"
                text="Подключить"
                class="rs232-connect-button"
                style="
                    width: 254px;
                    height: 40px;
                    margin: 0px;" />

        </ui:VisualElement>

        <!-- Правая панель настроек -->

        <ui:VisualElement
            name="port-settings"
            class="rs232-settings-panel"
            style="
                position: absolute;
                top: 0px;
                bottom: 0px;
                right: 0px;
                width: 244px;
                padding: 12px;
                flex-direction: column;
                justify-content: space-between;">

            <!-- COM-порт -->

            <ui:VisualElement name="port-picker">

                <ui:Label
                    text="COM-порт"
                    class="rs232-field-label"
                    style="margin-bottom: 6px;" />

                <ui:DropdownField
                    name="port-dropdown"
                    class="dark-dropdown"
                    style="
                        height: 36px;
                        margin: 0px;" />

            </ui:VisualElement>

            <!-- Baud Rate и Data Bits -->

            <ui:VisualElement
                name="data-settings"
                style="flex-direction: row;">

                <ui:VisualElement
                    style="
                        width: 106px;
                        min-width: 0px;
                        margin-right: 8px;">

                    <ui:Label
                        text="Baud Rate"
                        class="rs232-field-label-small"
                        style="margin-bottom: 6px;" />

                    <ui:TextField
                        name="baudrate-input"
                        class="dark-input"
                        value="9600"
                        select-all-on-focus="false"
                        select-all-on-mouse-up="false"
                        style="
                            height: 36px;
                            margin: 0px;" />

                </ui:VisualElement>

                <ui:VisualElement
                    style="
                        width: 106px;
                        min-width: 0px;">

                    <ui:Label
                        text="Data Bits"
                        class="rs232-field-label-small"
                        style="margin-bottom: 6px;" />

                    <ui:TextField
                        name="databits-input"
                        class="dark-input"
                        value="8"
                        select-all-on-focus="false"
                        select-all-on-mouse-up="false"
                        style="
                            height: 36px;
                            margin: 0px;" />

                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Parity и Stop Bits -->

            <ui:VisualElement
                name="format-settings"
                style="flex-direction: row;">

                <ui:VisualElement
                    style="
                        width: 106px;
                        min-width: 0px;
                        margin-right: 8px;">

                    <ui:Label
                        text="Parity"
                        class="rs232-field-label-small"
                        style="margin-bottom: 6px;" />

                    <ui:TextField
                        name="parity-input"
                        class="dark-input"
                        value=""
                        select-all-on-focus="false"
                        select-all-on-mouse-up="false"
                        style="
                            height: 36px;
                            margin: 0px;" />

                </ui:VisualElement>

                <ui:VisualElement
                    style="
                        width: 106px;
                        min-width: 0px;">

                    <ui:Label
                        text="Stop Bits"
                        class="rs232-field-label-small"
                        style="margin-bottom: 6px;" />

                    <ui:TextField
                        name="stopbits-input"
                        class="dark-input"
                        value="1"
                        select-all-on-focus="false"
                        select-all-on-mouse-up="false"
                        style="
                            height: 36px;
                            margin: 0px;" />

                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Flow Control -->

            <ui:VisualElement name="flow-settings">

                <ui:Label
                    text="Flow Control"
                    class="rs232-field-label-small"
                    style="margin-bottom: 6px;" />

                <ui:TextField
                    name="flowcontrol-input"
                    class="dark-input"
                    value=""
                    select-all-on-focus="false"
                    select-all-on-mouse-up="false"
                    style="
                        height: 36px;
                        margin: 0px;" />

            </ui:VisualElement>

            <!-- Переключатели DTR и RTS -->

            <ui:VisualElement
                name="signal-controls"
                style="
                    flex-direction: row;
                    height: 30px;">

                <ui:Toggle
                    name="dtr-toggle"
                    class="signal-button"
                    text="DTR"
                    value="false"
                    style="
                        width: 106px;
                        height: 30px;
                        margin: 0px;
                        margin-right: 8px;" />

                <ui:Toggle
                    name="rts-toggle"
                    class="signal-button"
                    text="RTS"
                    value="false"
                    style="
                        width: 106px;
                        height: 30px;
                        margin: 0px;" />

            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>
